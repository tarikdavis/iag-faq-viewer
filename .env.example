# Copy to .env.local for local dev; set the same vars in Netlify env for prod.
# The Delivery API token is READ-ONLY — safe to expose to the browser.
# Find / create at: https://app.contentful.com/spaces/<space>/api/keys

VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_DELIVERY_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master
